# Copia este archivo a .env.local y rellena las claves (nunca subas .env.local al repositorio).
# En Vercel: Project Settings → Environment Variables.

# Chat con OpenAI, generación de imágenes y voz en tiempo real (Realtime API).
OPENAI_API_KEY=

# Chat con Claude.
ANTHROPIC_API_KEY=

# Proveedor por defecto del chat de texto: "anthropic" u "openai".
DEFAULT_PROVIDER=anthropic

# Búsqueda web (opcional). Sin esta clave, la herramienta webSearch responde "no configurada".
TAVILY_API_KEY=
