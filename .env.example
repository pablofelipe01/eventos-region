# Copia este archivo a .env.local y rellena las claves (nunca subas .env.local al repositorio).
# En Vercel: Project Settings → Environment Variables.

# Chat con OpenAI, generación de imágenes, voz en tiempo real (Realtime API)
# y búsqueda web de la voz. La búsqueda web del chat usa la herramienta nativa
# de cada proveedor: no hace falta ninguna clave adicional.
OPENAI_API_KEY=

# Chat con Claude.
ANTHROPIC_API_KEY=

# Proveedor por defecto del chat de texto: "anthropic" u "openai".
DEFAULT_PROVIDER=anthropic

# Alma — Las Moras: respuestas de voz en Airtable (token con data.records:write).
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
